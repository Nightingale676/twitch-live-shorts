OPENAI_API_KEY=
TWITCH_CHANNEL=twitch
# Optional single-channel recording. Default is discovery across creators.
LIVE_RECORDING=false
OPENAI_MODEL=gpt-4o
# Existing local video; Twitch recording/downloading is not implemented.
INPUT_VIDEO=raw_clip.mp4
OUTPUT_DIR=output


# Live mode ignores INPUT_VIDEO. Full path to streamlink.exe:
STREAMLINK_PATH=

# Optional: show public Twitch clips in the reels feed. Keep the secret server-side.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

